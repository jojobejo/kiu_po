+                {$qtyReadyExpr} AS qty_ready,
+                GREATEST({$qtyReadyExpr} - COALESCE(plot.qty_plot, 0), 0) AS qty_available_plot
+            FROM tbpo_barang_nk a
+            JOIN tbpo_satuan b ON b.id_satuan = a.satuan
+            {$lokasiJoin}
+            LEFT JOIN (
