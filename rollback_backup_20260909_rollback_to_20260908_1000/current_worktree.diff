+    public function search_stock_ready($keyword, $limit = 20)
+    {
+        $keyword = trim((string) $keyword);
+        $limit = max(1, min((int) $limit, 50));
+        $binds = array();
+
+        if ($this->db->table_exists('v_stockbarangnk')) {
+            $hasLokasiField = $this->db->field_exists('nama_lokasi', 'v_stockbarangnk');
+            $lokasiSelect = $hasLokasiField ? 's.nama_lokasi' : "'' AS nama_lokasi";
+            $where = 'WHERE COALESCE(s.qty_ready, 0) > 0';
+
+            if ($keyword !== '') {
+                $like = '%' . $keyword . '%';
+                $where .= ' AND (s.kode_barangs LIKE ? OR s.kode_barang LIKE ? OR s.nama_barang LIKE ? OR s.deskripsi LIKE ?)';
+                $binds = array($like, $like, $like, $like);
+            }
+
+            $sql = "SELECT
+                    s.kode_barangs AS kd_barang,
+                    s.kode_barang AS kd_bsys,
+                    s.nama_barang,
+                    s.deskripsi,
+                    s.satuan,
+                    s.kat_barang,
+                    {$lokasiSelect},
+                    COALESCE(s.qty_in, 0) AS qty_in,
+                    COALESCE(s.qty_out, 0) AS qty_out,
+                    COALESCE(s.qty_ready, 0) AS qty_ready,
+                    GREATEST(COALESCE(s.qty_ready, 0) - COALESCE(plot.qty_plot, 0), 0) AS qty_available_plot
+                FROM v_stockbarangnk s
+                LEFT JOIN (
+                    SELECT kd_barang, SUM(qty_plot) AS qty_plot
+                    FROM tbpo_jasa_stock_plot
+                    WHERE status_plot = 'ACTIVE'
+                    GROUP BY kd_barang
