+
+    function pojasaResetInputs(container) {
+        var fields = container.querySelectorAll('input, textarea, select');
+        var jenis = container.closest('[data-jenis]') ? container.closest('[data-jenis]').getAttribute('data-jenis') : 'JASA';
+        Array.prototype.forEach.call(fields, function(field) {
+            if (field.type === 'hidden' && field.name === 'satuan[]') {
+                field.value = jenis === 'BAHAN' ? 'Pcs' : 'Lot';
+            } else if (field.type === 'hidden' && field.name === 'jenis_detail[]') {
