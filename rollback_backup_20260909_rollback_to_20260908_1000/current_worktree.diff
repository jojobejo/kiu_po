+        function normalizeFileExt(file) {
+            var ext = (file.file_ext || '').toString().toLowerCase().replace('.', '');
+            var original = (file.file_original || file.file_name || '').toString();
+            if (!ext && original.indexOf('.') !== -1) {
+                ext = original.split('.').pop().toLowerCase();
+            }
+
+            return ext;
+        }
+
+        function isImageFile(file) {
+            return ['jpg', 'jpeg', 'png'].indexOf(normalizeFileExt(file)) !== -1;
+        }
+
+        function fileIconClass(file) {
+            var ext = normalizeFileExt(file);
+            if (['jpg', 'jpeg', 'png'].indexOf(ext) !== -1) {
+                return 'fa-file-image';
+            }
+            if (ext === 'pdf') {
+                return 'fa-file-pdf';
+            }
+            if (['xls', 'xlsx', 'csv'].indexOf(ext) !== -1) {
+                return 'fa-file-excel';
+            }
+            if (['doc', 'docx', 'rtf'].indexOf(ext) !== -1) {
+                return 'fa-file-word';
+            }
+            if (['ppt', 'pptx'].indexOf(ext) !== -1) {
+                return 'fa-file-powerpoint';
+            }
+            if (ext === 'txt') {
+                return 'fa-file-alt';
+            }
+
+            return 'fa-file';
+        }
+
+        function previewAttributes(file, id) {
