+    if (is_super_admin()) {
+        return true;
+    }
+
+    return po_permission_allowed_for_role($permissionKey, $roleLevel);
+}
+
+function po_permission_locked($permission, $roleLevel)
+{
+    if ((string) $roleLevel === '1') {
+        return true;
+    }
+
+    $lockedRoles = isset($permission['locked_roles']) ? $permission['locked_roles'] : array();
+
+    return in_array((string) $roleLevel, $lockedRoles, true);
+}
