+<script>
+    function pojasaPreviewSupportDocument(link, event) {
+        if (!link) {
+            return true;
+        }
+
+        var isImage = link.getAttribute('data-is-image') === '1';
+        if (!isImage) {
+            return true;
+        }
+
+        if (event && event.preventDefault) {
+            event.preventDefault();
+        }
+        if (event && event.stopImmediatePropagation) {
+            event.stopImmediatePropagation();
+        } else if (event && event.stopPropagation) {
+            event.stopPropagation();
+        }
+
+        var fileUrl = link.getAttribute('data-file-url') || link.getAttribute('href');
+        var downloadUrl = link.getAttribute('data-file-download-url') || fileUrl;
+        var fileName = link.getAttribute('data-file-name') || 'Preview Dokumen Pendukung';
+
+        if (window.jQuery && jQuery.fn.modal && jQuery('#modalPreviewFilePojasa').length) {
+            jQuery('#previewFileTitlePojasa').text(fileName);
+            jQuery('#previewImagePojasa').attr('src', fileUrl);
+            jQuery('#previewDownloadPojasa').attr('href', downloadUrl);
+            jQuery('#modalPreviewFilePojasa').modal('show');
+            return false;
+        }
+
+        window.open(fileUrl, '_blank');
+        return false;
+    }
+
+    function pojasaDownloadSupportDocument(link, event) {
+        if (!link || !link.getAttribute('href')) {
+            return false;
+        }
+
+        return true;
+    }
+</script>
