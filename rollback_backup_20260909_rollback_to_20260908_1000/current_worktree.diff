+    function pojasaSendForm(url, form, successMessage) {
+        if (!form || form.getAttribute('data-submitting') === '1') {
+            return false;
+        }
+
+        var xhr = new XMLHttpRequest();
+        xhr.open('POST', url, true);
+        xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
+        form.setAttribute('data-submitting', '1');
+
+        if (typeof Swal !== 'undefined') {
+            Swal.fire({
+                title: 'Memproses',
+                allowOutsideClick: false,
+                didOpen: function() {
+                    Swal.showLoading();
+                }
+            });
+        }
+
+        xhr.onreadystatechange = function() {
+            if (xhr.readyState !== 4) {
+                return;
+            }
+
+            form.removeAttribute('data-submitting');
+            pojasaHandleJsonResponse(xhr.responseText, successMessage);
+        };
+
+        xhr.send(new FormData(form));
+
+        return false;
+    }
+
+    function pojasaSendPost(url, data, successMessage) {
+        var xhr = new XMLHttpRequest();
+        xhr.open('POST', url, true);
+        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded; charset=UTF-8');
+        xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
+
+        if (typeof Swal !== 'undefined') {
+            Swal.fire({
+                title: 'Memproses',
+                allowOutsideClick: false,
+                didOpen: function() {
+                    Swal.showLoading();
+                }
+            });
+        }
+
+        xhr.onreadystatechange = function() {
+            if (xhr.readyState !== 4) {
+                return;
+            }
+
+            pojasaHandleJsonResponse(xhr.responseText, successMessage);
+        };
+
+        var payload = [];
+        Object.keys(data).forEach(function(key) {
+            payload.push(encodeURIComponent(key) + '=' + encodeURIComponent(data[key]));
+        });
+        xhr.send(payload.join('&'));
+
+        return false;
+    }
+
+    function pojasaHandleJsonResponse(responseText, fallbackMessage) {
+        var response = null;
+        try {
+            response = JSON.parse(responseText || '{}');
+        } catch (e) {
+            response = {
+                success: false,
+                message: 'Server tidak mengembalikan JSON.'
+            };
+        }
+
+        var success = !!(response.success || response.status);
+        var message = response.message || fallbackMessage || (success ? 'Proses berhasil.' : 'Proses gagal.');
+        var redirect = response.redirect || '';
+
+        if (typeof Swal !== 'undefined') {
+            Swal.fire(success ? 'Berhasil' : 'Gagal', message, success ? 'success' : 'error').then(function() {
+                if (success && redirect) {
+                    window.location.href = redirect;
+                } else if (success) {
+                    window.location.reload();
+                }
+            });
+        } else {
+            alert(message);
+            if (success && redirect) {
+                window.location.href = redirect;
+            } else if (success) {
+                window.location.reload();
+            }
+        }
+    }
