+    private function buildPojasaDocumentPreview($path, $ext)
+    {
+        if ($ext === 'pdf') {
+            return array('type' => 'embed');
+        }
+
+        if ($ext === 'csv') {
+            return array('type' => 'table', 'rows' => $this->readCsvPreviewRows($path));
+        }
+
+        if ($ext === 'txt') {
+            return array('type' => 'text', 'content' => $this->readTextPreview($path));
+        }
+
+        if ($ext === 'rtf') {
+            return array('type' => 'text', 'content' => $this->plainTextFromRtf($this->readTextPreview($path, 300000)));
+        }
+
+        if (in_array($ext, array('xls', 'xlsx'), true)) {
+            return $this->readSpreadsheetPreview($path);
+        }
+
+        if ($ext === 'docx') {
+            return array('type' => 'text', 'content' => $this->readDocxTextPreview($path));
+        }
+
+        if ($ext === 'pptx') {
+            return array('type' => 'text', 'content' => $this->readPptxTextPreview($path));
+        }
+
+        return array('type' => 'embed');
+    }
+
+    private function readTextPreview($path, $limit = 300000)
+    {
+        $content = file_get_contents($path, false, null, 0, $limit);
+
+        return $content === false ? '' : $content;
+    }
+
+    private function readCsvPreviewRows($path)
+    {
+        $rows = array();
+        $handle = fopen($path, 'r');
+        if (!$handle) {
+            return $rows;
+        }
+
+        while (($row = fgetcsv($handle)) !== false && count($rows) < 200) {
+            $rows[] = $row;
+        }
+
+        fclose($handle);
+
+        return $rows;
+    }
+
+    private function readSpreadsheetPreview($path)
+    {
+        if (!class_exists('PHPExcel_IOFactory')) {
+            require_once APPPATH . 'third_party/PHPExcel/PHPExcel.php';
+        }
+
+        try {
+            $reader = PHPExcel_IOFactory::createReaderForFile($path);
+            $reader->setReadDataOnly(true);
+            $excel = $reader->load($path);
+            $sheet = $excel->getActiveSheet();
+            $highestRow = min((int) $sheet->getHighestRow(), 200);
+            $highestColumn = $sheet->getHighestColumn();
+            $highestColumnIndex = min(PHPExcel_Cell::columnIndexFromString($highestColumn), 50);
+            $rows = array();
+
+            for ($row = 1; $row <= $highestRow; $row++) {
+                $rowData = array();
+                for ($col = 0; $col < $highestColumnIndex; $col++) {
+                    $rowData[] = $sheet->getCellByColumnAndRow($col, $row)->getFormattedValue();
+                }
+                $rows[] = $rowData;
+            }
+
+            return array('type' => 'table', 'rows' => $rows);
+        } catch (Exception $e) {
+            return array(
+                'type' => 'message',
+                'content' => 'Preview Excel tidak dapat dibaca. Silakan buka file asli atau download dokumen.'
+            );
+        }
+    }
+
+    private function readDocxTextPreview($path)
+    {
+        if (!class_exists('ZipArchive')) {
+            return '';
+        }
+
+        $zip = new ZipArchive();
+        if ($zip->open($path) !== true) {
+            return '';
+        }
+
+        $xml = $zip->getFromName('word/document.xml');
+        $zip->close();
+        if ($xml === false) {
+            return '';
+        }
+
+        $xml = preg_replace('/<\/w:p>/', "\n", $xml);
+
+        return trim(html_entity_decode(strip_tags($xml), ENT_QUOTES, 'UTF-8'));
+    }
+
+    private function readPptxTextPreview($path)
+    {
+        if (!class_exists('ZipArchive')) {
+            return '';
+        }
+
+        $zip = new ZipArchive();
+        if ($zip->open($path) !== true) {
+            return '';
+        }
+
+        $slides = array();
+        for ($i = 0; $i < $zip->numFiles; $i++) {
+            $entry = $zip->getNameIndex($i);
+            if (preg_match('#^ppt/slides/slide([0-9]+)\.xml$#', $entry, $matches)) {
+                $slides[(int) $matches[1]] = $entry;
+            }
+        }
+        ksort($slides);
+
+        $text = array();
+        foreach ($slides as $slideNumber => $entry) {
+            $xml = $zip->getFromName($entry);
+            if ($xml === false) {
+                continue;
+            }
+
+            $xml = preg_replace('/<\/a:p>/', "\n", $xml);
+            $slideText = trim(html_entity_decode(strip_tags($xml), ENT_QUOTES, 'UTF-8'));
+            if ($slideText !== '') {
+                $text[] = 'Slide ' . $slideNumber . "\n" . $slideText;
+            }
+        }
+
+        $zip->close();
+
+        return implode("\n\n", $text);
+    }
+
+    private function plainTextFromRtf($content)
+    {
+        $content = preg_replace('/\\\\par[d]?/', "\n", $content);
+        $content = preg_replace('/\\\\[a-z]+-?\d* ?/i', '', $content);
+        $content = str_replace(array('{', '}'), '', $content);
+
+        return trim($content);
+    }
