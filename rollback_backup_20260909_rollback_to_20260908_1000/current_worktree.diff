+        $qtyReadyExpr = "({$qtyInExpr} - {$qtyOutExpr})";
+        $where = "WHERE {$qtyReadyExpr} > 0";
+
+        if ($keyword !== '') {
+            $like = '%' . $keyword . '%';
+            $where .= ' AND (a.kd_barang LIKE ? OR a.kd_br_adm LIKE ? OR a.nama_barang LIKE ? OR a.descnk LIKE ?)';
